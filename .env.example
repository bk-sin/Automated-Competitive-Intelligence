# ---------------------------------------------------------------------------
# Portal
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public key. Names accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy anon)
# or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (new dashboard: sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only, never exposed to the browser.
# Names accepted: SUPABASE_SERVICE_ROLE_KEY (legacy service_role JWT)
# or SUPABASE_SECRET_KEY (new dashboard: sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Firecrawl (https://firecrawl.dev)
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible chat completions)
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Email (Resend, https://resend.com) - plain text only
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Inteligencia Competitiva <reportes@your-domain.com>
# Internal team inbox: onboarding notifications + Firecrawl failure alerts.
ADMIN_EMAIL=equipo@your-domain.com

# ---------------------------------------------------------------------------
# Cron protection (shared secret sent as "Authorization: Bearer ...")
# ---------------------------------------------------------------------------
CRON_SECRET=
